=> END
~ lesha_met
if Global.met_dmitry:
	if Global.met_lesha == false:
		set Global.met_lesha = true
		Ты: "Привет"
		Леша: "Ой!!!"
		Леша: "О-ой извини, я тебя не увидел, привет!"
		Леша: "Скажи здесь красиво, уже 4 час сижу и разглядываю эту станцию"
		Ты: "Да-да...[wait=0.3] красиво...[wait=0.3] очень"
		Ты: (если глаза закрыть)
		Ты: "А ты не знаешь что-нибудь насчет нашей работы?"
		Леша: "А? Работы? Нет, я не слушал"
		Ты: (Замечательно)
		Ты: "Я пожалуй пойду.."
		Леша: "Удачи те- [next=0.1]"
		Ты: "Да-да тебе тоже"
		=> END
	elif Global.met_vlad and Global.met_lesha:
		Ты: (может хотя бы она расскажет, уж кто,но она точно знает)
		=> END
	else:
		Ты: (Лучше распрошу остальных)
		=> END
else:
	Ты: (сначала придеться поговорить с "лидером")
	=> END
~ vlad_met
if Global.met_dmitry:
	if Global.met_vlad == false:
		set Global.met_vlad = true
		Влад: (опять этот ветер, уже в 5 раз причесываюсь, если еще раз мне придетс)
		Влад: "Ой ,ты как долго тут стоишь? На будущее, следить за коллегами очень не правильно (даже если они восхитительно выглядят)"
		Ты: "Только подошел, с чего ты взял, что за тобой следят?"
		Влад: "Ха, если бы не следил, то и не спрашивал бы этот вопрос. Вот я тебя и поймал"
		Ты: (у него все в порядке с головой)
		Ты: "Ты расскажешь мне про нашу работу здесь"
		Влад: "Я бы рассказал, но ты вряд-ли поймешь, ха. Я тебе не учитель, чтобы меня все расспрашивать"
		Ты: "до свидания.."
		=> END	
	elif Global.met_vlad and Global.met_lesha == true:
		Ты: (может хотя бы она расскажет, уж кто, но она точно знает)
	else:
		Ты: (полезнее некуда)
		=> END
else:
	Ты: (Сначала придеться поговорить с "лидером")
	=> END
	
~ eva_met
Ты: "Привет, ты не занята?"
if Global.met_vlad and Global.met_lesha:
	Ева: "Нет, только доделала конспект"
	Ты: "Ты не могла ли рассказать про нашу работу?"
	Ева: "Да, для начала нам надо"
	ОПОВЕЩЕНИЕ: "Обеденный перерыв окончен, всем перейти к работе"
	Ева: "Ой ,нам пора бежать"
	Ты: "Эй, ты куда, а о-обьяснить работу...?"
	=> END
else:
	Ева: "Да ,немного занята, можешь дать две минутки?"
	Ты: "Хорошо"
	=> END
